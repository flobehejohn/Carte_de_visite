{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "composite": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",

    "scripts/**/*.ts",
    "scripts/**/*.tsx",

    "vite.config.ts",
    "vitest.config.ts",

    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "audit",
    "megalinter-reports",
    ".megalinter-reports",
    ".cache",

    "**/*.generated.d.ts",
    "vite.config.d.ts",
    "vitest.config.d.ts"
  ]
}
