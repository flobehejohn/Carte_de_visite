diff --git a/src/scene/RitualOrchestrator.js b/src/scene/RitualOrchestrator.js
--- a/src/scene/RitualOrchestrator.js
+++ b/src/scene/RitualOrchestrator.js
@@ -714,7 +714,7 @@
-  applyTargetsToRuntime(ctx, targets, safetyFactor = 1) {
+  applyTargetsToRuntime(ctx, targets, safetyFactor = 1, bloomClamp = null) {
     if (!ctx) return;

     const safeFactor = Number.isFinite(safetyFactor) ? clamp01(safetyFactor) : 1.0;
@@ -761,16 +761,35 @@
-    if (ctx.bloomPass && targets?.bloom) {
-      if (typeof targets.bloom.strength === 'number') ctx.bloomPass.strength = targets.bloom.strength * safeFactor;
-      if (typeof targets.bloom.radius === 'number') ctx.bloomPass.radius = targets.bloom.radius;
-      if (typeof targets.bloom.threshold === 'number') ctx.bloomPass.threshold = targets.bloom.threshold;
-      ctx.appliedBloomStrength = ctx.bloomPass.strength ?? null;
-    } else if (ctx.bloomPass) {
-      ctx.appliedBloomStrength = ctx.bloomPass.strength ?? null;
-    } else {
-      ctx.appliedBloomStrength = null;
-    }
+    // Bloom (idempotent, single-writer). Clamp safety intégré ici.
+    const clamp = bloomClamp && typeof bloomClamp === 'object' ? bloomClamp : null;
+
+    if (ctx.bloomPass) {
+      const b = targets?.bloom;
+
+      // strength (targets * safeFactor, puis override clamp si fourni)
+      let nextStrength = null;
+      if (typeof b?.strength === 'number') nextStrength = b.strength * safeFactor;
+      if (clamp?.strength != null) nextStrength = clamp.strength;
+      if (typeof nextStrength === 'number') ctx.bloomPass.strength = nextStrength;
+
+      // radius
+      let nextRadius = null;
+      if (typeof b?.radius === 'number') nextRadius = b.radius;
+      if (clamp?.radius != null) nextRadius = clamp.radius;
+      if (typeof nextRadius === 'number') ctx.bloomPass.radius = nextRadius;
+
+      // threshold
+      let nextThreshold = null;
+      if (typeof b?.threshold === 'number') nextThreshold = b.threshold;
+      if (clamp?.threshold != null) nextThreshold = clamp.threshold;
+      if (typeof nextThreshold === 'number') ctx.bloomPass.threshold = nextThreshold;
+
+      ctx.appliedBloomStrength = ctx.bloomPass.strength ?? null;
+    } else {
+      ctx.appliedBloomStrength = null;
+    }
@@ -798,6 +817,25 @@
     } else {
       ctx.appliedVignette = null;
     }
+
+    // DEV-only: log throttlé (max 1/2s) des valeurs appliquées (bloom/fog)
+    if (import.meta.env?.DEV) {
+      const now = typeof performance !== 'undefined' && performance?.now ? performance.now() : Date.now();
+      const last = this._runtimeApplyLogAt ?? 0;
+      if (now - last >= 500) {
+        this._runtimeApplyLogAt = now;
+        const fogD = ctx.appliedFogDensity;
+        const bloomS = ctx.appliedBloomStrength;
+        const fogStr = typeof fogD === 'number' ? fogD.toFixed(4) : String(fogD);
+        const bloomStr = typeof bloomS === 'number' ? bloomS.toFixed(3) : String(bloomS);
+        // eslint-disable-next-line no-console
+        console.debug(`[RuntimeApply] fog=${fogStr} bloom=${bloomStr} safe=${safeFactor.toFixed(2)}`);
+      }
+    }
   }
@@ -940,25 +978,13 @@
     const safety = this.ctx.lightSafetyGovernor?.update(dtMs) || null;
     const safetyFactor = safety?.safetyFactor ?? 1.0;
     this.ctx.safetyFactor = safetyFactor;

-    this.applyTargetsToRuntime(this.ctx, this.ctx.climateTargets, safetyFactor);
+    this.applyTargetsToRuntime(this.ctx, this.ctx.climateTargets, safetyFactor, safety?.bloomClamp ?? null);

     if (this.ctx.renderer && typeof this.ctx.baseExposure === 'number') {
       this.ctx.renderer.toneMappingExposure = this.ctx.baseExposure * safetyFactor;
     }

-    if (this.ctx.bloomPass && safety?.bloomClamp) {
-      if (safety.bloomClamp.strength != null) this.ctx.bloomPass.strength = safety.bloomClamp.strength;
-      if (safety.bloomClamp.radius != null) this.ctx.bloomPass.radius = safety.bloomClamp.radius;
-      if (safety.bloomClamp.threshold != null) this.ctx.bloomPass.threshold = safety.bloomClamp.threshold;
-    }
     if (this.ctx.renderer && safety?.exposureClamp != null) {
       const currentExposure = this.ctx.renderer.toneMappingExposure;
       this.ctx.renderer.toneMappingExposure =
         typeof currentExposure === 'number' ? Math.min(currentExposure, safety.exposureClamp) : safety.exposureClamp;
     }
-    if (this.ctx.bloomPass) {
-      this.ctx.appliedBloomStrength = this.ctx.bloomPass.strength ?? null;
-    }
diff --git a/scripts/audit-runtime.ps1 b/scripts/audit-runtime.ps1
--- a/scripts/audit-runtime.ps1
+++ b/scripts/audit-runtime.ps1
@@ -146,6 +146,30 @@
         $textSansBlock = $text.Replace($block, "")
+
+        # Phase 1 (CI Pro): bloomPass ne doit PAS être écrit hors applyTargetsToRuntime
+        # (sinon doublon/contradiction avec le clamp safety).
+        $bloomWriteOutside = Count-Matches $textSansBlock "this\.ctx\.bloomPass\.(strength|radius|threshold)\s*="
+        if ($bloomWriteOutside -gt 0) {
+            Warn "Phase1: bloomPass écrit hors applyTargetsToRuntime x$bloomWriteOutside"
+            AddCheck "phase1:bloomOutside" "WARN" "Writes=$bloomWriteOutside"
+        }
+        else {
+            Ok "Phase1: pas d'écriture bloomPass hors applyTargetsToRuntime."
+            AddCheck "phase1:bloomOutside" "OK" "Writes=0"
+        }
+
+        # Phase 1 (optionnel mais recommandé): bloomClamp géré dans applyTargetsToRuntime
+        if ($block -match "\bbloomClamp\b") {
+            Ok "Phase1: bloomClamp détecté dans applyTargetsToRuntime."
+            AddCheck "phase1:bloomClampParam" "OK" "Present"
+        }
+        else {
+            Warn "Phase1: bloomClamp NON détecté dans applyTargetsToRuntime (attendu: clamp intégré)."
+            AddCheck "phase1:bloomClampParam" "WARN" "Missing"
+        }
         $fogNewOutside = Count-Matches $textSansBlock "new\s+THREE\.FogExp2"
         if ($fogNewOutside -gt 0) { Warn "FogExp2 new hors applyTargetsToRuntime x$fogNewOutside"; AddCheck "fog:newOutside" "WARN" "Occurrences=$fogNewOutside" }
         else { Ok "Pas de FogExp2 new en dehors de applyTargetsToRuntime."; AddCheck "fog:newOutside" "OK" "Occurrences=0" }
