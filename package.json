{
  "name": "oracle-zarathustra-llmed",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.3.0",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "gate": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\gate.ps1",
    "diag:exports": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/diag-exports.ps1",
    "diag:envfix": "node -r ./scripts/diag/hook-spawn.cjs scripts/diag/envfix-selftest.cjs",
    "test:seq:scene": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/vitest-seq.ps1",
    "ph3:lock": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/ph3-lock.ps1",
    "audit:cleanup": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup-audit.ps1 -KeepLast 10",
    "audit:orb": "tsx scripts/orb-deep-audit.ts --runs 10 --out audit/orb_audit_report.txt",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@types/three": "^0.182.0",
    "framer-motion": "^11.18.2",
    "motion-dom": "^11.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.23",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
