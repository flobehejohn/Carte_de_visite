[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [string]$RepoRoot = "",

    [string]$OutDir = ".\audit\runtime",
    [string]$RunStamp = ""
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$script:WarnCount = 0
$script:ErrCount = 0
$script:LogLines = New-Object System.Collections.Generic.List[string]

function Log([string]$level, [string]$msg, [ConsoleColor]$color = [ConsoleColor]::Gray) {
    $line = "[$level] $msg"
    $script:LogLines.Add($line) | Out-Null
    Write-Host $line -ForegroundColor $color
}
function Info($m) { Log "INFO" $m ([ConsoleColor]::Gray) }
function Ok($m) { Log "OK"   $m ([ConsoleColor]::Green) }
function Warn($m) { Log "WARN" $m ([ConsoleColor]::Yellow); $script:WarnCount++ }
function Err($m) { Log "ERR"  $m ([ConsoleColor]::Red); $script:ErrCount++ }

function Resolve-RepoRoot() {
    if ($RepoRoot -and $RepoRoot.Trim().Length -gt 0) {
        return [string](Resolve-Path -LiteralPath $RepoRoot).Path
    }
    $scriptDir = Split-Path -Parent $PSCommandPath
    return [string](Resolve-Path -LiteralPath (Join-Path $scriptDir "..")).Path
}

function Ensure-Dir([string]$p) {
    if (-not (Test-Path -LiteralPath $p)) {
        New-Item -ItemType Directory -Force -Path $p | Out-Null
    }
}

function Read-TextFile([string]$path) {
    return Get-Content -LiteralPath $path -Raw -Encoding UTF8
}

function Count-Matches([string]$text, [string]$pattern) {
    return ([regex]::Matches($text, $pattern)).Count
}

function Extract-FunctionBlock([string]$text, [string]$fnName) {
    $idx = $text.IndexOf($fnName)
    if ($idx -lt 0) { return $null }

    $openIdx = $text.IndexOf("{", $idx)
    if ($openIdx -lt 0) { return $null }

    $depth = 0
    for ($i = $openIdx; $i -lt $text.Length; $i++) {
        $ch = $text[$i]
        if ($ch -eq "{") { $depth++ }
        elseif ($ch -eq "}") {
            $depth--
            if ($depth -eq 0) { return $text.Substring($idx, ($i - $idx + 1)) }
        }
    }
    return $null
}

function Write-JsonSafe([object]$o, [string]$path) {
    try {
        $json = $o | ConvertTo-Json -Depth 50
        Set-Content -LiteralPath $path -Value $json -Encoding UTF8
        return $true
    }
    catch {
        Err ("JSON write failed: {0}" -f $_.Exception.Message)
        Err ("JSON write type  : {0}" -f $_.Exception.GetType().FullName)
        if ($_.InvocationInfo) {
            Err ("JSON write at    : {0}:{1}" -f $_.InvocationInfo.ScriptName, $_.InvocationInfo.ScriptLineNumber)
        }
        return $false
    }
}

# ---------------- main ----------------
try {
    $root = Resolve-RepoRoot
    Set-Location $root
    Info "Repo root : $root"

    if (-not $RunStamp -or $RunStamp.Trim().Length -eq 0) {
        $RunStamp = (Get-Date).ToString("yyyyMMdd_HHmmss")
    }
    $RunStamp = [string]$RunStamp

    $OutDir = [string]$OutDir
    $absOutDir = Join-Path $root $OutDir
    Ensure-Dir $absOutDir

    $orchPath = Join-Path $root "src\scene\RitualOrchestrator.js"
    if (!(Test-Path -LiteralPath $orchPath)) {
        Err "Introuvable: $orchPath"
        exit 1
    }

    Info "Analyse: $orchPath"
    $text = Read-TextFile $orchPath

    $logTxt = Join-Path $absOutDir ("runtimeaudit_{0}.txt" -f $RunStamp)
    $logJson = Join-Path $absOutDir ("runtimeaudit_{0}.json" -f $RunStamp)
    $latestTxt = Join-Path $absOutDir "runtimeaudit-latest.txt"
    $latestJson = Join-Path $absOutDir "runtimeaudit-latest.json"

    # IMPORTANT: tableau simple sérialisable (pas de List[object])
    $checks = @()
    function AddCheck([string]$name, [string]$status, [string]$detail) {
        $script:checks += [pscustomobject]@{ name = $name; status = $status; detail = $detail }
    }

    if ($text -match "bloomEndMul") {
        Warn "Token 'bloomEndMul' détecté : reliquat probable."
        AddCheck "bloomEndMul" "WARN" "Présent"
    }
    else {
        Ok "Aucun 'bloomEndMul' trouvé."
        AddCheck "bloomEndMul" "OK" "Absent"
    }

    $block = Extract-FunctionBlock $text "applyTargetsToRuntime"
    if ($null -eq $block) {
        Err "Impossible d'extraire le bloc applyTargetsToRuntime(...) { ... }"
        AddCheck "applyTargetsToRuntime:block" "ERR" "Extraction KO"
    }
    else {
        Ok "Bloc applyTargetsToRuntime extrait."
        AddCheck "applyTargetsToRuntime:block" "OK" "Extraction OK"

        $bloomStrengthAssignCount = Count-Matches $block "ctx\.bloomPass\.strength\s*="
        $bloomRadiusAssignCount = Count-Matches $block "ctx\.bloomPass\.(radius|blurRadius)\s*="
        $bloomThresholdAssignCount = Count-Matches $block "ctx\.bloomPass\.threshold\s*="
        $volumeCfgDeclCount = Count-Matches $block "const\s+volumeCfg\b"
        $fogNewCount = Count-Matches $block "new\s+THREE\.FogExp2"
        $fogCacheCount = Count-Matches $block "ctx\._fogExp2"

        if ($bloomStrengthAssignCount -gt 1) { Warn "applyTargetsToRuntime: assign bloom strength x$bloomStrengthAssignCount"; AddCheck "bloom:strengthAssign" "WARN" "Occurrences=$bloomStrengthAssignCount" }
        else { Ok "applyTargetsToRuntime: assign bloom strength OK (occurrences: $bloomStrengthAssignCount)."; AddCheck "bloom:strengthAssign" "OK" "Occurrences=$bloomStrengthAssignCount" }

        if ($bloomRadiusAssignCount -gt 1) { Warn "applyTargetsToRuntime: bloom radius assign x$bloomRadiusAssignCount"; AddCheck "bloom:radiusAssign" "WARN" "Occurrences=$bloomRadiusAssignCount" }
        else { Ok "applyTargetsToRuntime: bloom radius assign OK (occurrences: $bloomRadiusAssignCount)."; AddCheck "bloom:radiusAssign" "OK" "Occurrences=$bloomRadiusAssignCount" }

        if ($bloomThresholdAssignCount -gt 1) { Warn "applyTargetsToRuntime: bloom threshold assign x$bloomThresholdAssignCount"; AddCheck "bloom:thresholdAssign" "WARN" "Occurrences=$bloomThresholdAssignCount" }
        else { Ok "applyTargetsToRuntime: bloom threshold assign OK (occurrences: $bloomThresholdAssignCount)."; AddCheck "bloom:thresholdAssign" "OK" "Occurrences=$bloomThresholdAssignCount" }

        if ($volumeCfgDeclCount -gt 1) { Warn "applyTargetsToRuntime: const volumeCfg x$volumeCfgDeclCount"; AddCheck "volumeCfg:decl" "WARN" "Occurrences=$volumeCfgDeclCount" }
        else { Ok "applyTargetsToRuntime: volumeCfg OK (occurrences: $volumeCfgDeclCount)."; AddCheck "volumeCfg:decl" "OK" "Occurrences=$volumeCfgDeclCount" }

        if ($fogNewCount -gt 1) { Warn "applyTargetsToRuntime: FogExp2 new x$fogNewCount"; AddCheck "fog:new" "WARN" "Occurrences=$fogNewCount" }
        else { Ok "applyTargetsToRuntime: FogExp2 new OK (occurrences: $fogNewCount)."; AddCheck "fog:new" "OK" "Occurrences=$fogNewCount" }

        if ($fogNewCount -ge 1 -and $fogCacheCount -eq 0) { Warn "FogExp2 créé mais pas de cache ctx._fogExp2 détecté dans le bloc."; AddCheck "fog:cache" "WARN" "Sans cache" }
        elseif ($fogCacheCount -ge 1) { Ok "Fog cache ctx._fogExp2 détecté."; AddCheck "fog:cache" "OK" "Cache présent" }

        $textSansBlock = $text.Replace($block, "")
        $fogNewOutside = Count-Matches $textSansBlock "new\s+THREE\.FogExp2"
        if ($fogNewOutside -gt 0) { Warn "FogExp2 new hors applyTargetsToRuntime x$fogNewOutside"; AddCheck "fog:newOutside" "WARN" "Occurrences=$fogNewOutside" }
        else { Ok "Pas de FogExp2 new en dehors de applyTargetsToRuntime."; AddCheck "fog:newOutside" "OK" "Occurrences=0" }

        $callCount = Count-Matches $text "this\.applyTargetsToRuntime\s*\("
        if ($callCount -ne 2) { Warn "Nombre d'appels this.applyTargetsToRuntime(...) = $callCount (attendu: 2)."; AddCheck "applyTargets:calls" "WARN" "Calls=$callCount" }
        else { Ok "Nombre d'appels this.applyTargetsToRuntime(...) = 2 (OK si 2-2)."; AddCheck "applyTargets:calls" "OK" "Calls=2" }

        if ($text -match "_climateWireOpacityMul") { Ok "Usage _climateWireOpacityMul détecté."; AddCheck "opacity:wireMul" "OK" "Présent" } else { Warn "Usage _climateWireOpacityMul NON détecté."; AddCheck "opacity:wireMul" "WARN" "Absent" }
        if ($text -match "_climateParticlesOpacityMul") { Ok "Usage _climateParticlesOpacityMul détecté."; AddCheck "opacity:particlesMul" "OK" "Présent" } else { Warn "Usage _climateParticlesOpacityMul NON détecté."; AddCheck "opacity:particlesMul" "WARN" "Absent" }
        if ($text -match "_climateForegroundOpacity") { Ok "Usage _climateForegroundOpacity détecté."; AddCheck "opacity:foreground" "OK" "Présent" } else { Warn "Usage _climateForegroundOpacity NON détecté."; AddCheck "opacity:foreground" "WARN" "Absent" }
    }

    Write-Host ""
    Write-Host "---- Résumé audit ----" -ForegroundColor Cyan
    Write-Host ("WARN: " + $script:WarnCount)
    Write-Host ("ERR : " + $script:ErrCount)

    # TXT toujours
    $script:LogLines.Add("") | Out-Null
    $script:LogLines.Add("---- Résumé audit ----") | Out-Null
    $script:LogLines.Add(("WARN: " + $script:WarnCount)) | Out-Null
    $script:LogLines.Add(("ERR : " + $script:ErrCount)) | Out-Null
    Set-Content -LiteralPath $logTxt -Value ($script:LogLines.ToArray()) -Encoding UTF8
    Copy-Item -LiteralPath $logTxt -Destination $latestTxt -Force

    $exitCode = 0
    if ($script:ErrCount -gt 0) { $exitCode = 1 }
    elseif ($script:WarnCount -gt 0) { $exitCode = 2 }

    $payload = [ordered]@{
        timestamp = (Get-Date).ToString("o")
        runStamp  = [string]$RunStamp
        repoRoot  = [string]$root
        file      = [string]$orchPath
        out       = [ordered]@{
            txt        = [string]$logTxt
            json       = [string]$logJson
            latestTxt  = [string]$latestTxt
            latestJson = [string]$latestJson
        }
        checks    = @($checks)
        summary   = [ordered]@{
            warn = [int]$script:WarnCount
            err  = [int]$script:ErrCount
            exit = [int]$exitCode
        }
    }

    $jsonOk = Write-JsonSafe $payload $logJson
    if ($jsonOk) {
        Copy-Item -LiteralPath $logJson -Destination $latestJson -Force
    }
    else {
        # si JSON KO => on force exit 1 (outil cassé => gate doit bloquer)
        $exitCode = 1
    }

    Info "Audit runtime log : $logTxt"
    Info "Audit runtime json: $logJson"
    exit $exitCode
}
catch {
    # dump détaillé + on essaye d’écrire un txt quand même
    $msg = $_.Exception.Message
    Write-Host ""
    Write-Host "[ERR] audit-runtime crashed: $msg" -ForegroundColor Red
    Write-Host ("[ERR] type: {0}" -f $_.Exception.GetType().FullName) -ForegroundColor Red
    if ($_.InvocationInfo) {
        Write-Host ("[ERR] at  : {0}:{1}" -f $_.InvocationInfo.ScriptName, $_.InvocationInfo.ScriptLineNumber) -ForegroundColor Red
    }
    exit 1
}
