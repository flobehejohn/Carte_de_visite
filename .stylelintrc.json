{
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "layer"
        ]
      }
    ],
    "function-no-unknown": [true, { "ignoreFunctions": ["theme"] }],

    "color-function-notation": null,
    "alpha-value-notation": null,
    "no-missing-end-of-source-newline": null
  }
}
